[Unit]
Description=Ringly Relay — демон-ретранслятор для обхода блокировок
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ringly-relay run -c /etc/ringly-relay/config.toml
Restart=on-failure
RestartSec=5

# Права на порт 443/3478 без root: разрешаем только биндинг привилегированных портов,
# всё остальное — под непривилегированным пользователем.
User=ringly-relay
Group=ringly-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Изоляция: демону не нужен доступ к ФС, кроме своего конфига.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/ringly-relay
# Состояние (токен регистрации в пуле) пишет сам демон — ему нужен каталог на запись
StateDirectory=ringly-relay
StateDirectoryMode=0700
Environment=RINGLY_RELAY_STATE_DIR=/var/lib/ringly-relay
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
