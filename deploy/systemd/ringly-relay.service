[Unit]
Description=Ringly Relay — volunteer relay daemon for getting around blocking
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ringly-relay run -c /etc/ringly-relay/config.toml
Restart=on-failure
RestartSec=5

# Ports 443/3478 without root: only binding privileged ports is allowed,
# everything else runs as an unprivileged user.
User=ringly-relay
Group=ringly-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Isolation: the daemon needs no filesystem access beyond its own config.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/ringly-relay
# The daemon writes its state (the pool registration token) — it needs a writable directory
StateDirectory=ringly-relay
StateDirectoryMode=0700
Environment=RINGLY_RELAY_STATE_DIR=/var/lib/ringly-relay
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
